# Copy to deploy/.env ON THE SERVER and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 32
ROOT_DOMAIN=cricketlegend.co.za
CLUB_HOSTS=irene.cricketlegend.co.za          # comma separated; add each new club here
GHCR_OWNER=                                    # GitHub user/org that owns the images (lowercase)
TAG=latest

PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=
APP_DB_NAME=cricketlegend_platform
APP_DB_USER=cricket
APP_DB_PASSWORD=
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=platform
KEYCLOAK_PUBLIC_CLIENT_ID=platform-web
KEYCLOAK_ADMIN_CLIENT_SECRET=                  # from the platform-provisioning client's Credentials tab

PUBLIC_AVAILABILITY_TOKEN_SECRET=
IMPORT_TOKEN_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@cricketlegend.co.za

MEDIA_HOST_DIR=/srv/cricketlegend/media        # real folder on the server; back it up
